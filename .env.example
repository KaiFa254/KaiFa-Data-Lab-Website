# =============================================================
# .env.example — the list of settings the app needs.
#
# HOW TO USE:
#   1. Copy this file and name the copy ".env"
#   2. Fill in real values in .env ONLY
#   3. Never commit .env (it is in .gitignore)
#
# Why: code is shared; secrets are not. The app reads these
# values from the environment at start-up (taught at Level 1–2).
# "Level N" shows when each setting is first needed.
# =============================================================

# ---- App basics (Level 2) ----
# development | test | production
APP_ENV=development
# full address of the site
APP_BASE_URL=http://127.0.0.1:8000
# long random string; signs sessions
SECRET_KEY=change-me

# ---- Database (Level 8) ----
# later: postgresql://user:pass@host:5432/db
DATABASE_URL=sqlite:///./data/dev.db

# ---- Admin bootstrap (Level 11) ----
ADMIN_EMAIL=you@example.com

# ---- Payments (Level 12) — provider chosen at that level ----
PAYMENT_PROVIDER=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# ---- File storage (Level 13) ----
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ---- Email (Level 15) ----
EMAIL_API_KEY=
EMAIL_FROM=hello@example.com

# ---- AI features (Level 22) ----
LLM_PROVIDER=
LLM_API_KEY=
